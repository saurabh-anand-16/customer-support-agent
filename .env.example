# Names only. Copy to .env and set values there; .env is in .gitignore and is never printed or logged.
# The OpenAI key for the chat model and the policy embeddings (required to run the agent):
OPENAI_API_KEY=
# Optional overrides for the [tracing] section of config/agent.toml (true or false):
TRACING_ENABLED=
TRACING_LANGFUSE_ENABLED=
TRACING_CAPTURE_TEXT=
# Langfuse (phase 6b, optional; only used when TRACING_LANGFUSE_ENABLED is true). Install with: pip install -r requirements-tracing.txt
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# The secret for the keyed hash that turns a customer id into the Langfuse user id (any long random text). The variable name is [tracing].hash_key_env_name.
LANGFUSE_HASH_KEY=
